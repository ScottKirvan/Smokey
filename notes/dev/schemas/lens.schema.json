{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lens.schema.json",
  "title": "Lens",
  "description": "Selects metrics, normalizes them into 0-100 dimensions and arranges them into panels. Draft, proposed: see notes/dev/rfc/0001-evidence-metrics-lenses.md.",
  "type": "object",
  "required": ["schema", "id", "version", "title", "subjects", "dimensions", "panels"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "<tool>/lens@0" },
    "id": {
      "type": "string",
      "description": "Namespaced lens ID, for example core/maintainer-habits. Shown next to every result.",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["user", "org", "repo"] }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dimension" }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/panel" }
    },
    "itemScore": {
      "type": "object",
      "description": "Optional weighted score over dimensions. Allowed for repos and orgs, never users.",
      "required": ["weights"],
      "additionalProperties": false,
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["itemScore"] },
      "then": { "properties": { "subjects": { "items": { "enum": ["org", "repo"] } } } }
    }
  ],
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["id", "title", "metrics", "normalizer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "metrics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "controllable": { "type": "boolean" },
        "normalizer": { "$ref": "#/$defs/normalizer" }
      }
    },
    "normalizer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "zero", "full"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "threshold" },
            "zero": { "type": "number" },
            "full": { "type": "number" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "full"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "log" },
            "full": { "type": "number", "exclusiveMinimum": 0, "description": "Value that maps to 100." }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "relative" } }
        },
        {
          "type": "object",
          "required": ["kind", "formula"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "formula" },
            "formula": { "type": "string", "description": "ID of a formula provided by a plugin, for example github-readme-stats/rank." }
          }
        }
      ]
    },
    "panel": {
      "type": "object",
      "required": ["kind", "title", "dimensions"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["trend", "profile", "small-multiples", "adoption-timeline", "today-list", "table"] },
        "title": { "type": "string" },
        "dimensions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
